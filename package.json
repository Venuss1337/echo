{
  "name": "echo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "eslint src && bun run format:check && tsc --noEmit && bun run test:contracts",
    "format:check": "prettier --check src scripts tests *.ts *.js *.json index.html .github/workflows",
    "test:unit": "vitest run",
    "test:e2e": "bun run build && playwright test",
    "gen:contracts": "cargo run --locked --manifest-path src-tauri/Cargo.toml --bin gen-contracts",
    "test:contracts": "cargo run --locked --manifest-path src-tauri/Cargo.toml --bin gen-contracts -- --check",
    "test:db": "cargo test --locked --manifest-path src-tauri/Cargo.toml --lib library::",
    "test:library-scale": "cargo test --profile scale --locked --manifest-path src-tauri/Cargo.toml --lib library::bench::bench_ -- --ignored --nocapture --test-threads=1",
    "test:native": "bun run fixtures:audio && cargo test --locked --manifest-path src-tauri/Cargo.toml --test native -- --include-ignored --skip native_worker --skip no_output_device",
    "test:security": "bun audit && pwsh -NoProfile -File scripts/check-rust-supply-chain.ps1",
    "fixtures:audio": "bun scripts/generate-fixture.ts",
    "verify": "bun run build && bun run check && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --locked --manifest-path src-tauri/Cargo.toml && bun run test:unit && playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-virtual": "3.14.28",
    "@tauri-apps/api": "2.12.5",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "license": "GPL-3.0-or-later",
  "packageManager": "bun@1.4.5"
}
